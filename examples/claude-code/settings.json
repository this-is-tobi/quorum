{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$HOME\"/.claude/hooks/quorum-commit.sh",
            "timeout": 660,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
