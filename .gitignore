# Based on https://raw.githubusercontent.com/github/gitignore/main/Node.gitignore

# Logs
logs
*.log
npm-debug.log*

# Caches
.cache

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional eslint cache
.eslintcache

# dotenv environment variable files
.env
.env.local
.env.*.local

# Husky's generated shim - regenerated by the "prepare" script on install,
# not meant to be committed (see https://typicode.github.io/husky/how-to.html)
.husky/_

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Compiled standalone binary (bun run compile)
/bin/

# Local working notes (backlog, findings, ADRs, specs, plans) - kept out of the repo
/.local/
