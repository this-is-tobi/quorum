{
  "name": "@tobi-or-not/quorum",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "bun@1.4.4",
  "description": "Multi-agent code review for diffs: a model proposes candidate findings, then a panel of blind voters judges each before it's reported.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/this-is-tobi/quorum.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "quorum": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run ./src/cli/bin.ts",
    "compile": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig ./src/cli/bin.ts --outfile ./bin/quorum",
    "compile:release": "bun run ./scripts/build-binaries.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "schema": "bun run ./scripts/schema.ts",
    "live:claude-code": "bun run ./scripts/live-claude-code.ts",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "prepare": "husky || true"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
