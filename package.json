{
  "name": "quorum",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "description": "Multi-agent security-review pipeline: an LLM proposes candidate vulnerabilities in a diff, then an independent panel votes on each before it's reported.",
  "repository": {
    "type": "git",
    "url": "https://github.com/this-is-tobi/quorum.git"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run ./src/cli/bin.ts",
    "compile": "bun build --compile ./src/cli/bin.ts --outfile ./bin/quorum",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
