diff --git a/lib/kredis/types/json.rb b/lib/kredis/types/json.rb
new file mode 100644
index 0000000..94b0905
--- /dev/null
+++ b/lib/kredis/types/json.rb
@@ -0,0 +1,19 @@
+class Kredis::Types::Json < Kredis::Types::Proxy
+  def value=(value)
+    set JSON.dump(value)
+  end
+
+  def value
+    if json = get
+      JSON.load(json)
+    end
+  end
+
+  def to_h
+    value || {}
+  end
+
+  def assigned?
+    exists?
+  end
+end
